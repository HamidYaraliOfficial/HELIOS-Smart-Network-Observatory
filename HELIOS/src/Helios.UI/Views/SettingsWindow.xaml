<Window
    x:Class="Helios.UI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24" Background="{ThemeResource HeliosCanvasBackgroundBrush}">
        <StackPanel Spacing="20" MaxWidth="640">

            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" />

            <!-- Appearance -->
            <StackPanel Spacing="8">
                <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16" />
                <ComboBox x:Name="ThemeComboBox" Width="260" SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Windows Default" Tag="WindowsDefault" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                    <ComboBoxItem Content="AMOLED Black" Tag="Amoled" />
                    <ComboBoxItem Content="Red" Tag="Red" />
                    <ComboBoxItem Content="Blue" Tag="Blue" />
                </ComboBox>
            </StackPanel>

            <!-- Language -->
            <StackPanel Spacing="8">
                <TextBlock Text="Language" FontWeight="SemiBold" FontSize="16" />
                <ComboBox x:Name="LanguageComboBox" Width="260" SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="English" />
                    <ComboBoxItem Content="فارسی (Persian)" Tag="Persian" />
                    <ComboBoxItem Content="中文 (Chinese)" Tag="Chinese" />
                </ComboBox>
            </StackPanel>

            <!-- Monitoring Schedule / Open Hours -->
            <StackPanel Spacing="8">
                <TextBlock Text="Monitoring Schedule (Open Hours)" FontWeight="SemiBold" FontSize="16" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource HeliosTextSecondaryBrush}"
                           Text="Define exactly when HELIOS should actively monitor this scope. Outside these hours, monitoring pauses and alerts are suppressed. Leave empty to always monitor." />

                <ToggleSwitch x:Name="ScheduleEnabledToggle" Header="Enable custom schedule" Toggled="ScheduleEnabledToggle_Toggled" />

                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="DayOfWeekComboBox" Grid.Column="0" PlaceholderText="Day">
                        <ComboBoxItem Content="Monday" />
                        <ComboBoxItem Content="Tuesday" />
                        <ComboBoxItem Content="Wednesday" />
                        <ComboBoxItem Content="Thursday" />
                        <ComboBoxItem Content="Friday" />
                        <ComboBoxItem Content="Saturday" />
                        <ComboBoxItem Content="Sunday" />
                    </ComboBox>
                    <TimePicker x:Name="OpenTimePicker" Grid.Column="1" />
                    <TimePicker x:Name="CloseTimePicker" Grid.Column="2" />
                    <Button x:Name="AddWindowButton" Grid.Column="3" Content="Add Time Window" Click="AddWindowButton_Click" />
                </Grid>

                <ListView x:Name="ScheduleWindowsListView" Height="140" />

                <Border Background="{ThemeResource HeliosPanelBackgroundBrush}" BorderBrush="{ThemeResource HeliosBorderBrush}" BorderThickness="1" Padding="12" CornerRadius="6">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Current status" FontWeight="SemiBold" />
                        <TextBlock x:Name="ScheduleStatusText" />
                        <TextBlock x:Name="ScheduleNextTransitionText" Foreground="{ThemeResource HeliosTextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Retention -->
            <StackPanel Spacing="8">
                <TextBlock Text="Data Retention" FontWeight="SemiBold" FontSize="16" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Keep metrics for" VerticalAlignment="Center" />
                    <NumberBox x:Name="MetricRetentionDaysBox" Width="90" Minimum="1" Value="30" SpinButtonPlacementMode="Inline" />
                    <TextBlock Text="days" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
