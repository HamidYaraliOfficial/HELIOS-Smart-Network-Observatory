<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="HeliosAccentColor">#3FA7FF</Color>
    <Color x:Key="HeliosCanvasBackgroundColor">#14171C</Color>
    <Color x:Key="HeliosPanelBackgroundColor">#1C2027</Color>
    <Color x:Key="HeliosBorderColor">#2B303A</Color>
    <Color x:Key="HeliosTextPrimaryColor">#F2F4F7</Color>
    <Color x:Key="HeliosTextSecondaryColor">#9AA3AF</Color>
    <Color x:Key="HeliosHealthyColor">#3FCB7C</Color>
    <Color x:Key="HeliosWarningColor">#F0C000</Color>
    <Color x:Key="HeliosDegradedColor">#FF9A44</Color>
    <Color x:Key="HeliosCriticalColor">#FF5C4D</Color>
    <Color x:Key="HeliosUnknownColor">#6B7484</Color>

    <SolidColorBrush x:Key="HeliosAccentBrush" Color="{StaticResource HeliosAccentColor}" />
    <SolidColorBrush x:Key="HeliosCanvasBackgroundBrush" Color="{StaticResource HeliosCanvasBackgroundColor}" />
    <SolidColorBrush x:Key="HeliosPanelBackgroundBrush" Color="{StaticResource HeliosPanelBackgroundColor}" />
    <SolidColorBrush x:Key="HeliosBorderBrush" Color="{StaticResource HeliosBorderColor}" />
    <SolidColorBrush x:Key="HeliosTextPrimaryBrush" Color="{StaticResource HeliosTextPrimaryColor}" />
    <SolidColorBrush x:Key="HeliosTextSecondaryBrush" Color="{StaticResource HeliosTextSecondaryColor}" />
    <SolidColorBrush x:Key="HeliosHealthyBrush" Color="{StaticResource HeliosHealthyColor}" />
    <SolidColorBrush x:Key="HeliosWarningBrush" Color="{StaticResource HeliosWarningColor}" />
    <SolidColorBrush x:Key="HeliosDegradedBrush" Color="{StaticResource HeliosDegradedColor}" />
    <SolidColorBrush x:Key="HeliosCriticalBrush" Color="{StaticResource HeliosCriticalColor}" />
    <SolidColorBrush x:Key="HeliosUnknownBrush" Color="{StaticResource HeliosUnknownColor}" />
</ResourceDictionary>
